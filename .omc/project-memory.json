  "build": {
    "buildCommand": "cat >> styles/main.css <<'EOF'\n\n/* =====================================================\n   [자체 구축 챗봇 위젯 - 고대비 모드]\n   위젯이 iframe이 아니라 사이트 DOM 내부에 있으므로\n   body.low-vision 전역 규칙을 그대로 상속받는다.\n   배경색만 명시적으로 지정해 주면 된다.\n   ===================================================== */\nbody.low-vision .chat-panel,\nbody.low-vision .chat-header,\nbody.low-vision .chat-log,\nbody.low-vision .chat-input-bar,\nbody.low-vision .chat-bubble-bot,\nbody.low-vision .chat-bubble-user {\n  background-color: #000 !important;\n  color: #fff !important;\n}\n\nbody.low-vision .chat-bubble-bot,\nbody.low-vision .chat-bubble-user {\n  border: 2px solid #00ffff !important;\n}\n\n/* 조작 가능한 요소는 노란색 계열로 (A11yBar 활성 버튼과 동일 규칙) */\nbody.low-vision .chat-launcher,\nbody.low-vision .chat-quick-reply,\nbody.low-vision .chat-action-card {\n  background-color: #000 !important;\n  color: #ffe812 !important;\n  border: 2px solid #ffe812 !important;\n}\n\nbody.low-vision .chat-launcher span,\nbody.low-vision .chat-quick-reply span,\nbody.low-vision .chat-action-card span,\nbody.low-vision .chat-action-hint {\n  color: #ffe812 !important;\n}\n\nbody.low-vision .chat-input-bar input {\n  background-color: #000 !important;\n  color: #fff !important;\n  border: 2px solid #00ffff !important;\n}\n\nbody.low-vision .chat-pending {\n  color: #fff !important;\n}\nEOF\necho \"main.css 확장 완료\"; npm run build 2>&1 | grep -E \"Compiled|Failed|error|Error|✓|chatbot|route\" | head -20",
    "testCommand": null,
    "lintCommand": "npm run lint",
    "devCommand": "npm run dev",
    "scripts": {
