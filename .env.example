# 서버 설정
PORT=3112
HOSTNAME=0.0.0.0

# API 기본 URL (상대 경로 사용 권장)
# 외부 접근 시에는 실제 도메인으로 변경
# NEXT_PUBLIC_API_URL=http://your-domain.com:3112

# 개발 환경
NODE_ENV=development

# ─── 챗봇 LLM (제공자 교체 가능) ─────────────────────────────
# CHATBOT_MODEL 만 필수. 인증은 아래 둘 중 하나로 결정된다.
#   1) GOOGLE_GENERATIVE_AI_API_KEY 가 있으면 → Google 직접 연결
#   2) 없으면 → Vercel AI Gateway (배포 환경은 OIDC로 자동 인증)
# 즉 Gateway로 전환하려면 GOOGLE_GENERATIVE_AI_API_KEY 만 지우면 된다.
CHATBOT_MODEL=google/gemini-3.5-flash-lite
# GOOGLE_GENERATIVE_AI_API_KEY=
CHATBOT_DAILY_AI_LIMIT=500

# ─── 관리자 인증 ─────────────────────────────────────────────
# 해시 생성: npm run admin:hash -- '새비밀번호'
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=scrypt:...
# ADMIN_SESSION_SECRET=

# ─── Supabase ────────────────────────────────────────────────
# 로컬 개발은 npm run db:start 후 출력되는 로컬 값을 사용한다.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ─── Cron (keepalive · 로그 파기) ─────────────────────────────
# Vercel Cron 은 CRON_SECRET 이 있으면 Authorization: Bearer 헤더를 자동으로 붙인다.
# 두 cron 라우트는 이 값이 없으면 503 으로 실행을 거부한다(무인증 실행 방지).
# CRON_SECRET=
# 대화 로그 보존 일수. 개인정보처리방침의 보관기간과 같아야 한다.
CHATBOT_LOG_RETAIN_DAYS=90
